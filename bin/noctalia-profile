#!/usr/bin/env python3
"""noctalia-profile — snapshot COMPLETO e portátil do desktop Noctalia.

v2: captura config/ inteiro, settings.toml, dados/plugin settings, assets
referenciados, frames, plugins locais e revisão das fontes git; reaplica em
outra máquina instalando fontes/plugins que faltarem.

 Comandos:
   save <nome>                       captura o estado atual
   apply <nome> [--dry-run] [--yes]  restaura e instala o que faltar
   list | delete <nome>
   export <nome> [arquivo.tar.gz]
   import <arquivo.tar.gz> [nome] [--force] [--no-apply] [--dry-run] [--yes]
"""
import argparse, hashlib, json, os, re, shutil, socket, subprocess, sys, tarfile, tempfile, time
from datetime import datetime
from pathlib import Path

HOME = Path(os.environ.get("HOME", Path.home())).resolve()
XDG_CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")).resolve()
XDG_STATE_HOME = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local" / "state")).resolve()
XDG_DATA_HOME = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local" / "share")).resolve()

CFG_DIR = XDG_CONFIG_HOME / "noctalia"
STATE_DIR = XDG_STATE_HOME / "noctalia"
SETTINGS = STATE_DIR / "settings.toml"
PROFILES = STATE_DIR / "profiles"
PLUGIN_DATA = STATE_DIR / "plugins" / "data"
PLUGIN_SOURCES = STATE_DIR / "plugins" / "sources"
MATERIALIZED = STATE_DIR / "plugins" / "materialized"
FRAMES = STATE_DIR / "frames"
LOCAL_PLUGINS_CFG = CFG_DIR / "plugins"
USER_PLUGINS = XDG_DATA_HOME / "noctalia" / "user-plugins"
FALLBACK_ASSETS = HOME / "Imagens" / "noctalia-profile"
EXPORT_DIR = HOME / "Documents" / "noctalia-profiles"
BACKUPS = STATE_DIR / "profile-backups"

SCHEMA_VERSION = 2
PACKAGE_VERSION = 2
MAX_TAR_BYTES = 512 * 1024 * 1024
MAX_MEMBER_BYTES = 256 * 1024 * 1024
TEXT_SUFFIXES = {".toml", ".json", ".jsonc", ".kdl", ".luau", ".txt", ".md",
                 ".qml", ".css", ".sh", ".service", ".path", ".conf"}
ASSET_SUFFIXES = {".png", ".jpg", ".jpeg", ".webp", ".gif", ".svg", ".bmp",
                  ".ico", ".ttf", ".otf", ".woff", ".woff2", ".eot"}


# ── utilitários ──────────────────────────────────────────────────────────────
def log(m):
    print(f"[noctalia-profile] {m}", file=sys.stderr)


def emit(line):
    print(line, flush=True)


def phase(msg):
    emit("PHASE=" + msg)
    log(msg)


def safe_name(name):
    name = re.sub(r"[^A-Za-z0-9_.-]", "_", str(name)).strip("._")
    return name or "perfil"


def portable(path):
    """Absolute path -> '~/...' quando dentro do HOME atual (não vaza usuário)."""
    s = str(path)
    h = str(HOME)
    if s == h:
        return "~"
    if s.startswith(h + os.sep):
        return "~" + s[len(h):]
    return s


def unportable(path):
    s = str(path)
    if s == "~":
        return str(HOME)
    if s.startswith("~" + os.sep):
        return str(HOME) + s[1:]
    return s


def sanitize_text(text):
    # Delimitador evita transformar /home/victor2 em ~2.
    return re.sub(re.escape(str(HOME)) + r"(?=/|$)", "~", str(text))


def expand_text(text):
    return re.sub(r"~(?=/|$)", lambda _: str(HOME), str(text))


def is_text(path):
    return Path(path).suffix.lower() in TEXT_SUFFIXES


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def noctalia_version():
    try:
        out = subprocess.run(["noctalia", "--version"], capture_output=True,
                             text=True, timeout=8)
        return (out.stdout or out.stderr).strip()
    except Exception:
        return ""


def run_cmd(argv, timeout=30):
    """Executa binário fixo (nunca algo vindo do perfil)."""
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
        return r.returncode == 0, (r.stdout or "").strip(), (r.stderr or "").strip()
    except subprocess.TimeoutExpired:
        return False, "", f"timeout após {timeout}s: {' '.join(argv)}"
    except FileNotFoundError:
        return False, "", f"comando não encontrado: {argv[0]}"


def load_settings(path=SETTINGS):
    import tomllib
    with open(path, "rb") as f:
        return tomllib.load(f)


# ── detecção e remapeamento de monitores ─────────────────────────────────────
def _normalize_output(o):
    return {
        "connector": str(o.get("connector") or o.get("name") or o.get("output") or ""),
        "description": str(o.get("description") or ""),
        "make": str(o.get("make") or ""),
        "model": str(o.get("model") or ""),
        "serial": str(o.get("serial") or ""),
        "width": int(o.get("width") or 0),
        "height": int(o.get("height") or 0),
        "primary": bool(o.get("primary", False)),
    }


def _parse_niri_outputs(text):
    out, cur = [], None
    for raw in text.splitlines():
        line = raw.strip()
        m = re.match(r'^Output\s+"([^"]+)"\s+\(([^)]+)\)', line)
        if m:
            desc, connector = m.group(1), m.group(2)
            parts = desc.split()
            make = parts[0] if parts else ""
            model = " ".join(parts[1:-1]) if len(parts) > 2 else (parts[1] if len(parts) > 1 else "")
            serial = parts[-1] if len(parts) > 2 and re.fullmatch(r"[A-Za-z0-9_-]{5,}", parts[-1]) else ""
            cur = {"connector": connector, "description": desc, "make": make,
                   "model": model, "serial": serial, "width": 0, "height": 0,
                   "primary": False}
            out.append(cur)
            continue
        if cur is None:
            continue
        m = re.match(r"^(?:Logical size|Current mode):\s*(\d+)x(\d+)", line)
        if m:
            cur["width"], cur["height"] = int(m.group(1)), int(m.group(2))
        m = re.match(r"^Logical position:\s*(-?\d+),\s*(-?\d+)", line)
        if m and int(m.group(1)) == 0 and int(m.group(2)) == 0:
            cur["primary"] = True
        if re.search(r"\bprimary\b", line, re.I):
            cur["primary"] = True
    if out and not any(o["primary"] for o in out):
        out[0]["primary"] = True
    return [_normalize_output(o) for o in out]


def _parse_wlr_outputs(text):
    data = json.loads(text)
    items = data.get("outputs", []) if isinstance(data, dict) else data
    out = []
    for o in items:
        mode = o.get("current_mode") or {}
        if not mode:
            mode = next((m for m in o.get("modes", []) if m.get("current")), {})
        out.append(_normalize_output({
            "name": o.get("name"), "description": o.get("description"),
            "make": o.get("make"), "model": o.get("model"), "serial": o.get("serial"),
            "width": mode.get("width") or o.get("width"),
            "height": mode.get("height") or o.get("height"),
            "primary": o.get("primary", False),
        }))
    return out


def _parse_hypr_outputs(text):
    data = json.loads(text)
    items = data if isinstance(data, list) else data.get("outputs", [])
    return [_normalize_output({
        "name": o.get("name"), "description": o.get("description"),
        "make": o.get("make"), "model": o.get("model"), "serial": o.get("serial"),
        "width": o.get("width"), "height": o.get("height"),
        "primary": o.get("primary", False) or o.get("id") == 0,
    }) for o in items]


def detect_outputs():
    """Outputs ativos. Override via NOCTALIA_PROFILE_OUTPUTS (JSON) para testes."""
    override = os.environ.get("NOCTALIA_PROFILE_OUTPUTS")
    if override:
        try:
            data = json.loads(override)
            items = data.get("outputs", []) if isinstance(data, dict) else data
            return [_normalize_output(o) for o in items]
        except Exception as e:
            log(f"aviso: NOCTALIA_PROFILE_OUTPUTS inválido: {e}")
    for argv, parser in (
        (["niri", "msg", "outputs"], _parse_niri_outputs),
        (["wlr-randr", "--json"], _parse_wlr_outputs),
        (["hyprctl", "monitors", "-j"], _parse_hypr_outputs),
    ):
        ok, out, _err = run_cmd(argv, timeout=10)
        if not ok or not out:
            continue
        try:
            parsed = parser(out)
        except Exception as e:
            log(f"aviso: falha ao interpretar {' '.join(argv)}: {e}")
            continue
        if parsed:
            return parsed
    return []


def build_output_map(saved_outputs, current_outputs):
    """Nunca deixa widget apontando para conector que não existe aqui."""
    if not current_outputs:
        return {}
    names = [o["connector"] for o in current_outputs]
    primary = next((o for o in current_outputs if o["primary"]), current_outputs[0])
    saved = [_normalize_output(o) for o in (saved_outputs or []) if o.get("connector")]
    mapping, used = {}, set()
    for o in saved:
        if o["connector"] in names:
            mapping[o["connector"]] = o["connector"]
            used.add(o["connector"])
    remaining = [o for o in current_outputs
                 if o["connector"] not in used and o["connector"] != primary["connector"]]
    saved_primary = next((o for o in saved if o["primary"]), saved[0] if saved else None)
    for o in saved:
        name = o["connector"]
        if name in mapping:
            continue
        if saved_primary and name == saved_primary["connector"]:
            mapping[name] = primary["connector"]
        elif remaining:
            mapping[name] = remaining.pop(0)["connector"]
        else:
            mapping[name] = primary["connector"]
    return mapping


def _toml_blocks(text):
    """Divide settings.toml em (cabeçalho, linhas), preservando o texto original."""
    blocks = [(None, [])]
    for line in text.splitlines(keepends=True):
        m = re.match(r"^\s*\[([^\]]+)\]", line)
        if m:
            blocks.append((m.group(1).strip(), [line]))
        else:
            blocks[-1][1].append(line)
    return blocks


def _key_value(lines, key):
    for line in lines:
        m = re.match(r"^\s*" + re.escape(key) + r"\s*=\s*(.+?)\s*(?:#.*)?$", line)
        if m:
            return m.group(1).strip().strip('"').strip("'")
    return None


def _set_key(line, key, value, quote=False):
    pattern = r"(\b" + re.escape(key) + r"\s*=\s*)" + (r'"[^"]*"' if quote else r"-?[\d.]+")
    return re.sub(pattern, lambda m: m.group(1) + (f'"{value}"' if quote else str(value)), line)


def _lock_ident(header):
    m = re.search(r'"([^"]*)"', header or "")
    return m.group(1) if m else None


def outputs_from_settings_text(text):
    """Fallback para manifests antigos: descobre outputs pelos widgets."""
    seen, out = set(), []
    for header, lines in _toml_blocks(text):
        if not header or ".widget." not in header:
            continue
        output = _key_value(lines, "output")
        if output and output not in seen:
            seen.add(output)
            out.append({"connector": output, "width": int(float(_key_value(lines, "placement_width") or 0)),
                        "height": int(float(_key_value(lines, "placement_height") or 0)),
                        "primary": len(out) == 0})
    return out


def remap_settings(text, output_map, current_outputs, saved_outputs):
    """Reescreve output/monitores/placement sem perder a ordem dos widgets."""
    blocks = _toml_blocks(text)
    cur_by_name = {o["connector"]: o for o in current_outputs}
    saved_by_name = {o["connector"]: o for o in saved_outputs}
    primary = next((o for o in current_outputs if o["primary"]), current_outputs[0])

    # IDs de lockscreen (@connector) e seções de wallpaper que viram duplicata.
    # Quando vários outputs antigos caem no mesmo conector, prefere o que era
    # primário na máquina original.
    preferred = next((o["connector"] for o in saved_outputs if o.get("primary")), None)
    renamed_locks, dup_locks, kept_locks = {}, set(), {}
    renamed_wall, dup_wall, kept_wall = {}, set(), {}
    for header, _lines in blocks:
        if not header:
            continue
        if header.startswith("lockscreen_widgets.widget."):
            ident = _lock_ident(header)
            if ident and "@" in ident:
                base, old = ident.rsplit("@", 1)
                new = base + "@" + output_map.get(old, old)
                renamed_locks[ident] = new
                if new in kept_locks:
                    if old == preferred:
                        dup_locks.discard(kept_locks[new])
                        dup_locks.add(ident)
                        kept_locks[new] = ident
                    else:
                        dup_locks.add(ident)
                else:
                    kept_locks[new] = ident
        m = re.match(r'^wallpaper\.monitors\.("?)([^"]+)\1$', header)
        if m:
            old = m.group(2)
            new = output_map.get(old, old)
            renamed_wall[old] = new
            if new in kept_wall:
                if old == preferred:
                    dup_wall.discard(kept_wall[new])
                    dup_wall.add(old)
                    kept_wall[new] = old
                else:
                    dup_wall.add(old)
            else:
                kept_wall[new] = old

    result, widgets = [], 0
    for header, lines in blocks:
        new_header = header
        if header and header.startswith("lockscreen_widgets.widget."):
            ident = _lock_ident(header)
            if ident in dup_locks:
                continue
            if ident in renamed_locks:
                new_header = re.sub(r'"[^"]*"', '"' + renamed_locks[ident] + '"', header, count=1)
        if header:
            m = re.match(r'^wallpaper\.monitors\.("?)([^"]+)\1$', header)
            if m:
                if m.group(2) in dup_wall:
                    continue
                new_header = f'wallpaper.monitors.{output_map.get(m.group(2), m.group(2))}'
        if header != new_header and new_header is not None:
            for i, line in enumerate(lines):
                if re.match(r"^\s*\[", line):
                    lines[i] = re.sub(r"^(\s*\[)[^\]]+(\])", lambda mm: mm.group(1) + new_header + mm.group(2), line)
                    break

        m = re.match(r"^(desktop_widgets|lockscreen_widgets)\.widget\.", header or "")
        if m and (header or "").rstrip().endswith(".settings"):
            m = None  # bloco de settings não é um widget novo
        if not m:
            # widget_order do lockscreen: troca os sufixos @connector e remove duplicatas
            if header in ("desktop_widgets", "lockscreen_widgets"):
                new_lines = []
                for line in lines:
                    if line.lstrip().startswith("widget_order") and header == "lockscreen_widgets":
                        ids = re.findall(r'"[^"]*"', line)
                        kept = []
                        for q in ids:
                            ident = q[1:-1]
                            if ident in dup_locks:
                                continue
                            if "@" in ident:
                                base, old = ident.rsplit("@", 1)
                                ident = base + "@" + output_map.get(old, old)
                            kept.append('"' + ident + '"')
                        line = re.sub(r"\[[^\]]*\]", "[" + ", ".join(kept) + "]", line, count=1)
                    new_lines.append(line)
                lines = new_lines
            result.extend(lines)
            continue

        widgets += 1 if m.group(1) == "desktop_widgets" else 0
        old_output = _key_value(lines, "output")
        if not old_output:
            ident = _lock_ident(header or "")
            old_output = ident.rsplit("@", 1)[-1] if ident and "@" in ident else ""
        new_output = output_map.get(old_output)
        if not new_output:
            new_output = old_output if old_output in cur_by_name else primary["connector"]
        old_dim = saved_by_name.get(old_output, {})
        old_w = int(float(old_dim.get("width") or _key_value(lines, "placement_width") or 0)) or 1
        old_h = int(float(old_dim.get("height") or _key_value(lines, "placement_height") or 0)) or 1
        new_dim = cur_by_name.get(new_output, primary)
        new_w = int(float(new_dim.get("width") or old_w))
        new_h = int(float(new_dim.get("height") or old_h))
        sx, sy = new_w / old_w, new_h / old_h

        new_lines = []
        for line in lines:
            if re.match(r"^\s*output\s*=", line):
                line = _set_key(line, "output", new_output, quote=True)
            elif re.match(r"^\s*placement_width\s*=", line):
                line = _set_key(line, "placement_width", new_w)
            elif re.match(r"^\s*placement_height\s*=", line):
                line = _set_key(line, "placement_height", new_h)
            elif re.match(r"^\s*cx\s*=", line):
                old = _key_value([line], "cx")
                if old:
                    line = _set_key(line, "cx", round(float(old) * sx, 2))
            elif re.match(r"^\s*cy\s*=", line):
                old = _key_value([line], "cy")
                if old:
                    line = _set_key(line, "cy", round(float(old) * sy, 2))
            new_lines.append(line)
        result.extend(new_lines)

    return "".join(result), output_map, widgets


def copy_tree(src, dst, sanitize=False, expand=False, skip=()):
    """Copia árvore; opcionalmente troca HOME por '~' (ou o contrário) em texto."""
    src, dst = Path(src), Path(dst)
    if not src.exists():
        return False
    dst.mkdir(parents=True, exist_ok=True)
    for item in src.rglob("*"):
        rel = item.relative_to(src)
        if any(part in skip for part in rel.parts):
            continue
        target = dst / rel
        if item.is_symlink():
            link = Path(os.readlink(item))
            if link.is_absolute() or ".." in link.parts:
                log(f"symlink ignorado (fora da árvore): {item}")
                continue
            target.parent.mkdir(parents=True, exist_ok=True)
            if target.exists() or target.is_symlink():
                target.unlink()
            target.symlink_to(link)
        elif item.is_dir():
            target.mkdir(parents=True, exist_ok=True)
        elif item.is_file():
            target.parent.mkdir(parents=True, exist_ok=True)
            if sanitize and is_text(item):
                try:
                    target.write_text(sanitize_text(item.read_text(encoding="utf-8")),
                                      encoding="utf-8")
                except UnicodeDecodeError:
                    shutil.copy2(item, target)
            elif expand and is_text(item):
                try:
                    target.write_text(expand_text(item.read_text(encoding="utf-8")),
                                      encoding="utf-8")
                except UnicodeDecodeError:
                    shutil.copy2(item, target)
            else:
                shutil.copy2(item, target)
    return True


def source_revision(name):
    repo = PLUGIN_SOURCES / safe_name(name) / "repo"
    if not (repo / ".git").exists():
        return ""
    ok, out, _ = run_cmd(["git", "-C", str(repo), "rev-parse", "HEAD"], timeout=10)
    return out if ok else ""


def manifest_sources(settings):
    sources = []
    for s in (settings.get("plugins", {}).get("source") or []):
        if not isinstance(s, dict):
            continue
        sources.append({
            "name": str(s.get("name", "")),
            "kind": str(s.get("kind", "git")),
            "location": portable(s.get("location", "")),
            "revision": source_revision(s.get("name", "")),
        })
    return sources


def collect_asset_paths(settings):
    found = []

    def walk(node):
        if isinstance(node, dict):
            for v in node.values():
                walk(v)
        elif isinstance(node, list):
            for v in node:
                walk(v)
        elif isinstance(node, str):
            s = node.strip()
            if not (s.startswith("/") or s.startswith("~")):
                return
            p = Path(unportable(s))
            if p.suffix.lower() in ASSET_SUFFIXES or (str(p).startswith(str(HOME)) and p.is_file()):
                found.append(str(p))

    walk(settings)
    seen, out = set(), []
    for p in found:
        if p not in seen:
            seen.add(p)
            out.append(p)
    return out


def write_manifest(prof, manifest):
    (prof / "manifest.json").write_text(
        json.dumps(manifest, indent=2, ensure_ascii=False), encoding="utf-8")


def read_manifest(prof):
    mf = prof / "manifest.json"
    if not mf.exists():
        return {}
    try:
        return json.loads(mf.read_text(encoding="utf-8"))
    except Exception as e:
        raise SystemExit(f"manifest.json inválido: {e}")


def compute_checksums(prof):
    sums = {}
    for item in sorted(prof.rglob("*")):
        if item.is_file() and item.name != "manifest.json":
            sums[str(item.relative_to(prof))] = sha256_file(item)
    return sums


# ── save ─────────────────────────────────────────────────────────────────────
def cmd_save(args):
    name = safe_name(args.name)
    prof = PROFILES / name
    if prof.exists():
        shutil.rmtree(prof)
    prof.mkdir(parents=True, exist_ok=True)

    # 1) ~/.config/noctalia INTEIRO (config, paletas, fontes, plugins locais)
    copy_tree(CFG_DIR, prof / "config", sanitize=True)
    # 2) settings.toml INTEIRO (sanitizado para não vazar HOME)
    if SETTINGS.exists():
        try:
            txt = SETTINGS.read_text(encoding="utf-8")
            (prof / "settings.toml").write_text(sanitize_text(txt), encoding="utf-8")
        except UnicodeDecodeError:
            shutil.copy2(SETTINGS, prof / "settings.toml")
    # 3) dados dos plugins
    copy_tree(PLUGIN_DATA, prof / "plugins-data", sanitize=True)
    # 4) molduras geradas
    copy_tree(FRAMES, prof / "frames", skip=(".lock",))
    # 5) fontes kind=path embarcadas
    try:
        settings = load_settings()
    except Exception as e:
        log(f"aviso: settings.toml ilegível: {e}")
        settings = {}
    for src in (settings.get("plugins", {}).get("source") or []):
        if not isinstance(src, dict) or str(src.get("kind", "")) != "path":
            continue
        location = Path(unportable(src.get("location", "")))
        if location.is_dir():
            copy_tree(location, prof / "local-plugins" / safe_name(src.get("name", "path")),
                      sanitize=True)

    # 6) TODOS os assets referenciados por caminhos absolutos
    assets_dir = prof / "assets"
    assets_dir.mkdir(parents=True, exist_ok=True)
    assets = {}
    for p in collect_asset_paths(settings):
        src = Path(p)
        if not src.is_file():
            log(f"aviso: asset referenciado não existe: {p}")
            continue
        digest = hashlib.sha1(p.encode("utf-8")).hexdigest()[:12]
        dst = assets_dir / f"{digest}{src.suffix.lower()}"
        shutil.copy2(src, dst)
        assets[portable(p)] = str(dst.relative_to(prof))

    plugins = settings.get("plugins", {}) or {}
    desktop = settings.get("desktop_widgets", {}) or {}
    widget_types = [{
        "id": wid,
        "type": str(w.get("type", "")),
        "output": str(w.get("output", "")),
    } for wid, w in (desktop.get("widget") or {}).items() if isinstance(w, dict)]
    desktop_manifest = dict(desktop)
    desktop_manifest["widget_count"] = len(widget_types)
    desktop_manifest["widget_types"] = widget_types

    local_plugins = []
    local_root = prof / "local-plugins"
    if local_root.is_dir():
        local_plugins += [d.name for d in sorted(local_root.iterdir()) if d.is_dir()]
    if LOCAL_PLUGINS_CFG.is_dir():
        local_plugins += [d.name for d in sorted(LOCAL_PLUGINS_CFG.iterdir()) if d.is_dir()]

    manifest = {
        "schema_version": SCHEMA_VERSION,
        "name": name,
        "saved_at": datetime.now().isoformat(timespec="seconds"),
        "hostname": socket.gethostname(),
        "home": portable(HOME),                   # "~" — sem vazamento de usuário
        "noctalia_version": noctalia_version(),
        "noctalia": noctalia_version(),          # compat v1
        "outputs": detect_outputs(),
        "plugins": {
            "enabled": list(plugins.get("enabled") or []),
            "sources": manifest_sources(settings),
            "local_plugins": sorted(set(local_plugins)),
        },
        "desktop_widgets": desktop_manifest,
        "assets": assets,
        "wallpapers": assets,                     # compat v1
        "checksums": compute_checksums(prof),
        "has_config": (prof / "config" / "config.toml").exists(),
        "has_settings": (prof / "settings.toml").exists(),
    }
    write_manifest(prof, manifest)
    print(str(prof))
    print(f"PROFILE={name}")
    log(f"perfil '{name}' salvo (schema v2, {len(assets)} assets)")


# ── plugin sources / enable ──────────────────────────────────────────────────
def list_sources():
    ok, out, err = run_cmd(["noctalia", "msg", "plugins", "source", "list"], timeout=20)
    if not ok:
        raise RuntimeError(f"falha ao listar fontes: {err or out}")
    result = {}
    for line in out.splitlines():
        parts = line.split()
        if len(parts) >= 2:
            result[parts[0]] = {"kind": parts[1], "location": " ".join(parts[2:])}
    return result


def list_plugins():
    ok, out, err = run_cmd(["noctalia", "msg", "plugins", "list"], timeout=20)
    if not ok:
        raise RuntimeError(f"falha ao listar plugins: {err or out}")
    result = {}
    for line in out.splitlines():
        parts = line.split()
        if parts and "/" in parts[0]:
            result[parts[0]] = " ".join(parts[1:])
    return result


def confirm_url(location):
    if os.environ.get("NOCTALIA_PROFILE_ASSUME_YES") == "1":
        return True
    if not sys.stdin.isatty():
        raise RuntimeError(f"fonte git desconhecida {location}; use --yes para confirmar")
    try:
        return input(f"Adicionar fonte git {location}? [s/N] ").strip().lower() in ("s", "sim", "y", "yes")
    except EOFError:
        return False


def install_sources(prof, manifest, args, installed, rewrites):
    """Prepara fontes e plugins ANTES de tocar na config do usuário."""
    sources = (manifest.get("plugins", {}).get("sources") or [])
    current = list_sources()
    for src in sources:
        name = safe_name(src.get("name", ""))
        if not name:
            continue
        kind = str(src.get("kind", "git"))
        original_location = str(src.get("location", ""))
        location = unportable(original_location)

        if kind == "path":
            embedded = prof / "local-plugins" / name
            if embedded.is_dir():
                dest = USER_PLUGINS / name
                dest.mkdir(parents=True, exist_ok=True)
                copy_tree(embedded, dest, expand=True)
                location = str(dest)
                # settings restaurado ainda aponta para o caminho antigo.
                rewrites[original_location] = portable(dest)
            elif not Path(location).is_dir():
                emit(f"MISSING_SOURCE={name}:{location}")
                continue

        if name not in current:
            if kind == "git" and not args.yes and not confirm_url(location):
                emit(f"MISSING_SOURCE={name}:recusado")
                continue
            argv = ["noctalia", "msg", "plugins", "source", "add", name, kind, location]
            ok, out, err = run_cmd(argv, timeout=30)
            if not ok:
                emit(f"ERROR=falha ao adicionar fonte {name}: {err or out}")
                raise RuntimeError(f"falha ao adicionar fonte {name}: {err or out}")
            installed.append(f"source:{name}")
            ok, out, err = run_cmd(["noctalia", "msg", "plugins", "update", name], timeout=120)
            if not ok:
                emit(f"AVISO=falha ao atualizar fonte {name}: {err or out}")
            current = list_sources()

        revision = src.get("revision")
        if revision:
            local = source_revision(name)
            if local and local != revision:
                emit(f"AVISO=revisão de {name}: esperada {revision[:8]}, local {local[:8]}")


def plugin_materialized(pid):
    """Verifica se o plugin está materializado em alguma fonte."""
    slug = pid.split("/", 1)[-1]
    if not MATERIALIZED.exists():
        return True  # máquina sem cache: deixa o enable decidir
    return any(d.is_dir() and d.name == slug for d in MATERIALIZED.glob("*/*"))


def install_plugins(manifest, installed, missing):
    wanted = [p for p in (manifest.get("plugins", {}).get("enabled") or []) if "/" in p]
    state = list_plugins()
    for i, pid in enumerate(wanted, 1):
        phase(f"instalando plugins {i}/{len(wanted)}: {pid}")
        info = state.get(pid, "")
        if "enabled" in info and plugin_materialized(pid):
            continue
        ok, out, err = run_cmd(["noctalia", "msg", "plugins", "enable", pid], timeout=30)
        if not ok:
            emit(f"ERROR=falha ao habilitar plugin {pid}: {err or out}")
            missing.append(pid)
            continue
        # confirma com timeout de 30s (habilitado E materializado)
        for _ in range(30):
            state = list_plugins()
            if "enabled" in state.get(pid, "") and plugin_materialized(pid):
                installed.append(pid)
                break
            time.sleep(1)
        else:
            emit(f"ERROR=plugin {pid} não apareceu após enable")
            missing.append(pid)
    return wanted


# ── backup / rollback ────────────────────────────────────────────────────────
def make_backup(name):
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    dest = BACKUPS / f"{safe_name(name)}-{stamp}"
    dest.mkdir(parents=True, exist_ok=True)
    for label, path in (("config", CFG_DIR), ("settings.toml", SETTINGS),
                        ("plugins-data", PLUGIN_DATA), ("frames", FRAMES)):
        if path.is_dir():
            copy_tree(path, dest / label)
        elif path.is_file():
            shutil.copy2(path, dest / label)
    log(f"backup criado em {dest}")
    return dest


def restore_backup(backup):
    if not backup or not backup.exists():
        return
    for label, path in (("config", CFG_DIR), ("settings.toml", SETTINGS),
                        ("plugins-data", PLUGIN_DATA), ("frames", FRAMES)):
        saved = backup / label
        if not saved.exists():
            continue
        if path.exists():
            shutil.rmtree(path) if path.is_dir() else path.unlink()
        path.parent.mkdir(parents=True, exist_ok=True)
        shutil.copytree(saved, path) if saved.is_dir() else shutil.copy2(saved, path)
    log(f"rollback aplicado a partir de {backup}")


# ── apply ────────────────────────────────────────────────────────────────────
def enrich_from_snapshot(manifest, prof):
    """Manifest v1 não registrava plugins/widget_types: completa pelo settings."""
    snap = prof / "settings.toml"
    if not snap.exists():
        return manifest
    try:
        s = load_settings(snap)
    except Exception as e:
        log(f"aviso: settings.toml do perfil ilegível: {e}")
        return manifest
    plugins = manifest.setdefault("plugins", {})
    if not plugins.get("enabled"):
        plugins["enabled"] = list((s.get("plugins") or {}).get("enabled") or [])
    if not plugins.get("sources"):
        plugins["sources"] = manifest_sources(s)
    desktop = manifest.setdefault("desktop_widgets", {})
    if not desktop.get("widget_types"):
        types = [{"id": wid, "type": str(w.get("type", "")),
                  "output": str(w.get("output", ""))}
                 for wid, w in ((s.get("desktop_widgets") or {}).get("widget") or {}).items()
                 if isinstance(w, dict)]
        desktop["widget_types"] = types
        desktop.setdefault("widget_count", len(types))
    return manifest


def apply_profile(name, args):
    prof = PROFILES / safe_name(name)
    if not prof.is_dir():
        raise SystemExit(f"perfil não encontrado: {prof}")
    manifest = read_manifest(prof)
    schema = int(manifest.get("schema_version", 1) or 1)
    enrich_from_snapshot(manifest, prof)
    installed, missing = [], []

    if args.dry_run:
        phase("simulação (dry-run)")
        emit(f"PROFILE={manifest.get('name', safe_name(name))}")
        emit("DRY_RUN=1")
        emit(f"WIDGETS_RESTORED={len((manifest.get('desktop_widgets') or {}).get('widget_types') or [])}")
        emit("OUTPUT_REMAP=" + ",".join(
            f"{k}->{v}" for k, v in build_output_map(
                manifest.get("outputs") or [], detect_outputs()).items()))
        emit("PLUGINS_INSTALLED=" + ",".join(installed))
        emit("INSTALLED_PLUGINS=" + ",".join(installed))  # compat painel antigo
        emit("MISSING_PLUGINS=" + ",".join(missing))
        log("dry-run: nada foi alterado")
        return manifest

    backup = make_backup(name)
    rewrites = {}
    try:
        phase(f"instalando plugins 0/{len(manifest.get('plugins', {}).get('enabled') or [])}")
        install_sources(prof, manifest, args, installed, rewrites)
        wanted = install_plugins(manifest, installed, missing)

        # Tipos de widget vindos de plugin precisam do plugin habilitado.
        widget_types = (manifest.get("desktop_widgets") or {}).get("widget_types") or []
        enabled_set = set(wanted)
        for w in widget_types:
            wtype = str(w.get("type", ""))
            if ":" not in wtype or "/" not in wtype.split(":", 1)[0]:
                continue
            owner = wtype.split(":", 1)[0]
            if owner not in enabled_set and owner not in missing:
                missing.append(owner)
                emit(f"ERROR=plugin {owner} do widget {w.get('id')} não está habilitado")

        phase("remapeando monitors")
        current_outputs = detect_outputs()
        saved_outputs = manifest.get("outputs") or []
        snap = prof / "settings.toml"
        snap_text = snap.read_text(encoding="utf-8") if snap.exists() else ""
        if not saved_outputs:
            saved_outputs = outputs_from_settings_text(snap_text)
        output_map = build_output_map(saved_outputs, current_outputs)
        if current_outputs:
            emit("OUTPUT_REMAP=" + ",".join(f"{k}->{v}" for k, v in output_map.items()))
        else:
            emit("AVISO=nenhum output detectado na máquina de destino")
        manifest["output_remap"] = output_map
        widgets_restored = 0

        phase("restaurando config")
        copy_tree(prof / "config", CFG_DIR, expand=True)
        copy_tree(prof / "plugins-data", PLUGIN_DATA, expand=True)
        copy_tree(prof / "frames", FRAMES, expand=True, skip=(".lock",))

        # assets: tenta o caminho original; se não der, usa fallback e reescreve
        assets = manifest.get("assets") or manifest.get("wallpapers") or {}
        for orig, rel in assets.items():
            src = prof / rel
            if not src.is_file():
                emit(f"MISSING_ASSET={orig}")
                continue
            dest = Path(unportable(orig))
            try:
                dest.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(src, dest)
            except Exception as e:
                log(f"aviso: não consegui restaurar {orig}: {e}")
                FALLBACK_ASSETS.mkdir(parents=True, exist_ok=True)
                fb = FALLBACK_ASSETS / src.name
                shutil.copy2(src, fb)
                rewrites[orig] = str(fb)

        phase("restaurando widgets")
        if snap.exists():
            txt = expand_text(snap_text)
            for old, new in rewrites.items():
                txt = txt.replace(unportable(old), unportable(new))
            if current_outputs:
                txt, output_map, widgets_restored = remap_settings(
                    txt, output_map, current_outputs, saved_outputs)
                manifest["output_remap"] = output_map
            tmp = SETTINGS.with_suffix(".toml.tmp")
            SETTINGS.parent.mkdir(parents=True, exist_ok=True)
            tmp.write_text(txt, encoding="utf-8")
            os.replace(tmp, SETTINGS)
            # rastreabilidade: grava o remap usado dentro do próprio perfil
            write_manifest(prof, manifest)

        phase("recarregando shell")
        ok, out, err = run_cmd(["noctalia", "msg", "config-reload"], timeout=20)
        if not ok:
            emit(f"AVISO=config-reload falhou: {err or out}")
        ok, out, err = run_cmd(["noctalia", "msg", "desktop-widgets-show"], timeout=20)
        if not ok and "unknown" not in err.lower():
            emit(f"AVISO=desktop-widgets-show falhou: {err or out}")

        # gerador de frames embarcado (nunca PATH). A variável de ambiente
        # permite importações headless/testes sem recriar molduras.
        gen = Path(__file__).resolve().parent / "noctalia-widget-frames"
        if os.environ.get("NOCTALIA_PROFILE_SKIP_FRAMES") == "1":
            log("gerador de molduras ignorado (NOCTALIA_PROFILE_SKIP_FRAMES=1)")
        elif gen.is_file():
            ok, out, err = run_cmd(["python3", str(gen), "--full"], timeout=120)
            if not ok:
                emit(f"AVISO=gerador de molduras falhou: {err or out}")

        # verificação final
        final_state = list_plugins()
        for pid in wanted:
            if "enabled" not in final_state.get(pid, ""):
                if pid not in missing:
                    missing.append(pid)
        diffs = []
        try:
            now = load_settings()
            expected_order = (manifest.get("desktop_widgets") or {}).get("widget_order")
            actual_order = (now.get("desktop_widgets") or {}).get("widget_order")
            if expected_order is not None and actual_order != expected_order:
                diffs.append("desktop_widgets.widget_order")
            for section in ("desktop_widgets", "lockscreen_widgets"):
                for widget in ((now.get(section) or {}).get("widget") or {}).values():
                    if isinstance(widget, dict) and widget.get("output") not in (
                            None, "") and current_outputs and widget["output"] not in (
                                o["connector"] for o in current_outputs):
                        diffs.append(f"output inválido:{widget['output']}")
                        break
        except Exception as e:
            diffs.append(f"settings.toml ilegível: {e}")
        for orig, rel in assets.items():
            if not Path(unportable(orig)).is_file() and orig not in rewrites:
                diffs.append(f"asset:{orig}")
                break

        for d in diffs:
            emit(f"DIFF={d}")
        emit(f"PROFILE={manifest.get('name', safe_name(name))}")
        emit("APPLIED=1")
        emit(f"WIDGETS_RESTORED={widgets_restored}")
        emit("OUTPUT_REMAP=" + ",".join(f"{k}->{v}" for k, v in output_map.items()))
        emit("PLUGINS_INSTALLED=" + ",".join(installed))
        emit("INSTALLED_PLUGINS=" + ",".join(installed))  # compat painel/service antigos
        emit("MISSING_PLUGINS=" + ",".join(missing))
        log(f"perfil '{name}' aplicado (schema v{schema}, {widgets_restored} widgets)")
        return manifest
    except Exception as e:
        restore_backup(backup)
        emit(f"ERROR={e}")
        raise SystemExit(1)


def cmd_apply(args):
    apply_profile(args.name, args)


# ── export / import ──────────────────────────────────────────────────────────
def cmd_export(args):
    name = safe_name(args.name)
    prof = PROFILES / name
    if not prof.is_dir():
        raise SystemExit(f"perfil não encontrado: {prof}")
    out = Path(args.output).expanduser() if args.output else EXPORT_DIR / f"{name}.tar.gz"
    out.parent.mkdir(parents=True, exist_ok=True)
    manifest = read_manifest(prof)
    manifest["name"] = manifest.get("name") or name
    manifest["exported_at"] = datetime.now().isoformat(timespec="seconds")
    manifest["package_version"] = PACKAGE_VERSION
    manifest["checksums"] = compute_checksums(prof)
    write_manifest(prof, manifest)
    with tarfile.open(out, "w:gz") as tf:
        for item in sorted(prof.rglob("*")):
            tf.add(item, arcname=str(item.relative_to(prof)), recursive=False)
    print(str(out))
    print(f"PROFILE={name}")
    log(f"perfil '{name}' exportado para {out}")


def validate_tar(tf):
    """Bloqueia caminhos absolutos, '..', symlinks escapando e arquivos enormes."""
    safe, total = [], 0
    root = Path("/__noctalia_import_root__")
    for m in tf.getmembers():
        raw = m.name
        parts = [x for x in Path(raw).parts if x not in (".", "")]
        if not parts:
            continue
        if Path(raw).is_absolute() or ".." in parts or raw.startswith("/"):
            raise SystemExit(f"pacote com caminho inseguro: {raw}")
        if m.issym() or m.islnk():
            target = Path(m.linkname)
            if target.is_absolute() or ".." in target.parts:
                raise SystemExit(f"symlink inseguro no pacote: {raw} -> {m.linkname}")
            resolved = (root.joinpath(*parts[:-1]) / target).resolve()
            if root not in resolved.parents and resolved != root:
                raise SystemExit(f"symlink escapa do destino: {raw}")
        if m.isdev() or m.isfifo():
            raise SystemExit(f"tipo de arquivo não permitido: {raw}")
        if m.size > MAX_MEMBER_BYTES:
            raise SystemExit(f"arquivo grande demais no pacote: {raw}")
        total += m.size
        if total > MAX_TAR_BYTES:
            raise SystemExit("pacote grande demais")
        m.name = str(Path(*parts))
        safe.append(m)
    names = [m.name for m in safe]
    if "manifest.json" not in names and "settings.toml" not in names:
        raise SystemExit("pacote não parece conter um perfil do Noctalia")
    return safe


def verify_checksums(prof, manifest):
    expected = manifest.get("checksums") or {}
    bad = []
    for rel, digest in expected.items():
        f = prof / rel
        if not f.is_file() or sha256_file(f) != digest:
            bad.append(rel)
    for rel in bad[:5]:
        emit(f"AVISO=checksum divergente: {rel}")
    if bad:
        emit(f"AVISO={len(bad)} arquivo(s) com checksum divergente")


def cmd_import(args):
    src = Path(args.file).expanduser()
    if not src.is_file():
        raise SystemExit(f"arquivo não encontrado: {src}")
    try:
        tf = tarfile.open(src, "r:gz")
    except Exception as e:
        raise SystemExit(f"arquivo inválido (não é .tar.gz): {e}")

    with tf:
        safe = validate_tar(tf)
        with tempfile.TemporaryDirectory(prefix="noctalia-import-") as td:
            tmp = Path(td)
            tf.extractall(tmp, members=safe)
            manifest = read_manifest(tmp)
            name = safe_name(args.name or manifest.get("name") or src.stem)
            dest = PROFILES / name
            if dest.exists() and not args.force:
                raise SystemExit(f"perfil '{name}' já existe; use --force para sobrescrever")

            # Preserva o perfil anterior até o import (e a aplicação) terminarem.
            old = None
            if dest.exists():
                stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
                old = dest.with_name(f".{name}.old-{stamp}")
                dest.rename(old)
            try:
                shutil.copytree(tmp, dest, dirs_exist_ok=True)

                imported_at = datetime.now().isoformat(timespec="seconds")
                manifest["name"] = name
                manifest["imported_at"] = imported_at
                manifest.setdefault("saved_at", imported_at)
                manifest.pop("exported_at", None)
                write_manifest(dest, manifest)
                verify_checksums(dest, manifest)

                print(str(dest))
                print(f"PROFILE={name}")
                if not args.no_apply:
                    # apply_profile emite PHASE=, APPLIED=1 e as listas finais.
                    apply_profile(name, args)
            except BaseException:
                shutil.rmtree(dest, ignore_errors=True)
                if old and old.exists():
                    old.rename(dest)
                    log(f"perfil anterior '{name}' restaurado após falha")
                raise
            else:
                if old:
                    shutil.rmtree(old, ignore_errors=True)
    log(f"perfil '{name}' importado de {src}")


# ── list / delete ────────────────────────────────────────────────────────────
def cmd_list(args):
    if not PROFILES.exists() or not any(PROFILES.iterdir()):
        print("nenhum perfil salvo")
        return
    for p in sorted(PROFILES.iterdir()):
        if p.is_dir():
            m = read_manifest(p)
            print(f" * {p.name}  ({m.get('saved_at', '?')} @ {m.get('hostname', '?')})"
                  + (f"  schema={m.get('schema_version', 1)}" if m else ""))


def cmd_delete(args):
    prof = PROFILES / safe_name(args.name)
    if not prof.is_dir():
        raise SystemExit(f"perfil não encontrado: {prof}")
    shutil.rmtree(prof)
    log(f"perfil '{args.name}' removido")


def main():
    ap = argparse.ArgumentParser(prog="noctalia-profile")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("save"); sp.add_argument("name"); sp.set_defaults(func=cmd_save)
    sp = sub.add_parser("apply"); sp.add_argument("name")
    sp.add_argument("--dry-run", action="store_true"); sp.add_argument("--yes", action="store_true")
    sp.set_defaults(func=cmd_apply)
    sp = sub.add_parser("list"); sp.set_defaults(func=cmd_list)
    sp = sub.add_parser("delete"); sp.add_argument("name"); sp.set_defaults(func=cmd_delete)
    sp = sub.add_parser("export"); sp.add_argument("name"); sp.add_argument("output", nargs="?")
    sp.set_defaults(func=cmd_export)
    sp = sub.add_parser("import"); sp.add_argument("file"); sp.add_argument("name", nargs="?")
    sp.add_argument("--force", action="store_true")
    sp.add_argument("--no-apply", action="store_true")
    sp.add_argument("--dry-run", action="store_true")
    sp.add_argument("--yes", action="store_true")
    sp.set_defaults(func=cmd_import)

    args = ap.parse_args()
    if getattr(args, "yes", False):
        os.environ["NOCTALIA_PROFILE_ASSUME_YES"] = "1"
    args.func(args)


if __name__ == "__main__":
    main()
